# Copy to .env.local and fill in. Never commit .env.local.

# --- Required for the pipeline -------------------------------------------

# Speech-to-text: transcription, language detection, diarization, sentiment.
# https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=

# LLM analysis (OpenAI-compatible API).
# https://console.x.ai
XAI_API_KEY=

# --- Required for the /interpreter demo (Hindi/French/English voice translator) -

# Whisper STT and GPT-4o-mini translation.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ElevenLabs TTS (multilingual v2 model handles Hindi, French and English).
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- Optional -----------------------------------------------------------

# Override interpreter models and voices if you want to swap providers/voices.
# INTERPRETER_STT_MODEL=whisper-1
# INTERPRETER_TRANSLATE_MODEL=gpt-4o-mini
# INTERPRETER_TTS_MODEL=eleven_multilingual_v2
# One optional voice per language: INTERPRETER_VOICE_<ISO code>.
# INTERPRETER_VOICE_EN=21m00Tcm4TlvDq8ikWAM
# INTERPRETER_VOICE_HI=21m00Tcm4TlvDq8ikWAM
# INTERPRETER_VOICE_FR=21m00Tcm4TlvDq8ikWAM

# Model name and endpoint. Any OpenAI-compatible server works here, including
# a self-hosted vLLM instance — point XAI_BASE_URL at it and set XAI_MODEL.
# XAI_MODEL=grok-4.5
# XAI_BASE_URL=https://api.x.ai/v1

# Access gate (docs/DEMO_ACCESS.md). Unset = the demo is open (fine locally).
# Set it before you deploy to a public URL, so strangers can't spend your credit.
# The pages stay public; the metered API routes need an access pass, which
# visitors get by entering their email (DEMO_ACCESS_SECRET) or a shared code
# (ACCESS_CODE). Either one turns the gate on. Rotating the secret revokes
# every pass. Generate with `openssl rand -base64 32`.
# DEMO_ACCESS_SECRET=
# ACCESS_CODE=
# DEMO_ID=voice-insight         # pass audience; "*" passes work on any demo sharing the secret
# DEMO_PASS_DAYS=7

# Email for access links, via Resend (https://resend.com). Without
# RESEND_API_KEY the link is printed in the server log instead (local testing).
# RESEND_API_KEY=
# ACCESS_EMAIL_FROM=Demo desk <demos@your-verified-domain.com>
# ACCESS_NOTIFY_EMAIL=you@example.com   # copy of every request + out-of-credit alerts
# DEMO_PUBLIC_URL=https://voice-insight.example.com   # base of the emailed link

# Public mode, the alternative to the gate: the API routes are open to
# everyone, but uploads are capped at this many MB (max 4.5). A valid access
# pass (link or code) lifts the cap back to 4.5 MB. Overrides the gate.
# Pair it with a firewall rate limit and prepaid provider credit — see README.
# PUBLIC_MAX_MB=1.5
