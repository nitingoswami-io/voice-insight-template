# Copy to .env.local and fill in. Never commit .env.local.

# --- Required for the pipeline -------------------------------------------

# Speech-to-text: transcription, language detection, diarization, sentiment.
# https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=

# LLM analysis (OpenAI-compatible API).
# https://console.x.ai
XAI_API_KEY=

# --- Optional -----------------------------------------------------------

# Model name and endpoint. Any OpenAI-compatible server works here, including
# a self-hosted vLLM instance — point XAI_BASE_URL at it and set XAI_MODEL.
# XAI_MODEL=grok-4.5
# XAI_BASE_URL=https://api.x.ai/v1

# Access gate. Unset = the demo is open (fine locally). Set it before you
# deploy to a public URL, so strangers can't spend your API credit.
# Use a long random value, e.g. `openssl rand -base64 24`.
# ACCESS_CODE=

# Public mode, for a hosted demo anyone can try. When set, /demo and the API
# routes are open to everyone, but uploads are capped at this many MB
# (max 4.5). A valid ACCESS_CODE cookie lifts the cap back to 4.5 MB.
# Pair it with a firewall rate limit and prepaid provider credit — see README.
# PUBLIC_MAX_MB=1.5
